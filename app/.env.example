# ─────────────────────────────────────────────────────────────
#  spotify-tv-jam configuration
#
#  Almost everything Spotify-related is now handled by the built-in
#  setup flow: run the server, and the TV shows a "Scan to set up"
#  QR code. Scan it with your phone, sign in with Spotify, done.
#  Credentials collected that way live in .data/auth.json and take
#  precedence over the values here.
# ─────────────────────────────────────────────────────────────

# ── Spotify (OPTIONAL — the /setup page can collect all of these) ──
# Pre-fill the Client ID here to skip typing it on the phone.
# Client Secret is NOT required (sign-in uses PKCE).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Legacy escape hatch: a hand-obtained refresh token still works.
SPOTIFY_REFRESH_TOKEN=

# ── Jam auto-QR + "who added" (optional) ──
# The sp_dc cookie from an open.spotify.com session (see README).
# Can also be pasted on the /setup page.
SPOTIFY_SP_DC=

# Troubleshoot a missing Jam QR: logs each social-connect attempt to the server
# console and adds a "debug" object to the jam data in /api/state.
JAM_DEBUG=false

# With sp_dc set, the server creates/activates the Jam by itself as soon as
# music is playing (same endpoint the web player uses). Set to false if you
# prefer to start Jams manually from the phone app.
JAM_AUTO_CREATE=true

# Optional manual override / emergency fallback.
# If the reverse-engineered Jam lookup can't find a session, the app
# will render this URL as the QR instead. Paste a Jam invite link here,
# or leave blank to just show "Start a Jam on your phone".
JAM_URL_FALLBACK=

# ── Weather (Open-Meteo, no API key) ──
WEATHER_CITY=San Francisco
# 24h clock? set to "true" for 24-hour time, "false" for 12-hour AM/PM
CLOCK_24H=false
# Units: "fahrenheit" or "celsius"
TEMP_UNIT=fahrenheit

# ── Server ──
PORT=3000
# HTTPS port for the phone sign-in flow (self-signed cert, generated
# automatically into .data/). Spotify requires OAuth redirects to be
# https, hence the second listener. Default: PORT+443.
HTTPS_PORT=3443
# How often the TV polls the server, in milliseconds
REFRESH_MS=5000

# ── Public setup link (Cloudflare quick tunnel) ──
# While sign-in is needed, the server opens a temporary public
# https://<random>.trycloudflare.com link (cloudflared is auto-downloaded
# into .data/ on first use). This gives the phone flow a clean HTTPS
# redirect URI with no certificate warnings. The tunnel closes by itself
# shortly after sign-in completes. Set to false to disable and use the
# self-signed LAN HTTPS flow instead.
TUNNEL=true

# ── Web player (the TV acts as a Spotify Connect device) ──
# With this on, the dashboard loads Spotify's Web Playback SDK and appears as
# a device named WEBPLAYER_NAME. It can play music itself — so the Jam has an
# active device and comes up with no phone/computer needed. Requires Spotify
# Premium, and a re-connect via /setup if you signed in before this existed
# (the sign-in now asks for the extra "streaming" permission). Set to false to
# turn the TV back into a display-only dashboard.
WEBPLAYER=true
WEBPLAYER_NAME=TV Jam

# Preview the UI with fake data (no Spotify creds needed): set to true
DEMO=false
