[Unit]
Description=RAMTECH first boot: create the kiosk user's home from /etc/skel
# Armbian images ship with an empty /home (the final rsync excludes it), so the
# kiosk session files (.xinitrc, .bash_profile) arrive via skel on first boot.
Before=getty@tty1.service spotify-tv-jam.service
ConditionPathExists=!/home/ramtech

[Service]
Type=oneshot
ExecStart=/sbin/mkhomedir_helper ramtech

[Install]
WantedBy=multi-user.target
