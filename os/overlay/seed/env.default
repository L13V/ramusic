# RAMTECH TV — seeded defaults for the x86 live USB. Everything else is
# configured on-screen via the /setup QR flow; values saved there win over this
# file.
#
# The panel plays the music itself: this image installs Google Chrome, which
# ships Widevine, so the Spotify Web Playback SDK works and the panel appears as
# the RAMTECH TV Connect device — no librespot sidecar. (That is the ARM story,
# and WEBPLAYER=false was copied from it; with the SDK off nothing here could
# ever become an active device, which also left JAM_AUTOSTART below with nothing
# to arm. deploy/install.sh turns it off for the ARM build, where it belongs.)
WEBPLAYER=true
WEBPLAYER_NAME=RAMTECH TV
JAM_PLAY_ON_GUEST=true
# Seed playlist when a guest joins and nothing is loaded on the account.
JAM_DEFAULT_URI=spotify:playlist:7mRfKFC3r6y4SMGugxVzsl
# Arm that playlist on boot (loaded but PAUSED) so the Jam + QR appear
# hands-free. Silent: sound starts when the first guest joins the Jam.
JAM_AUTOSTART=true
# Snappy UI polling (jam lookups are internally cached to ~4s regardless).
REFRESH_MS=2000
