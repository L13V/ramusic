# RAMTECH TV — seeded defaults. Everything else is configured on-screen via
# the /setup QR flow; values saved there win over this file.
# The Pi plays audio through librespot (raspotify), not the browser SDK.
WEBPLAYER=false
WEBPLAYER_NAME=RAMTECH TV
JAM_PLAY_ON_GUEST=true
# Seed playlist when a guest joins and nothing is loaded on the account.
JAM_DEFAULT_URI=spotify:playlist:7mRfKFC3r6y4SMGugxVzsl
# Arm that playlist on boot (loaded but PAUSED) so the Jam + QR appear
# hands-free. Silent: sound starts when the first guest joins the Jam.
JAM_AUTOSTART=true
# Snappy UI polling (jam lookups are internally cached to ~4s regardless).
REFRESH_MS=2000
