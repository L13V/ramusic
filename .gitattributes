# Shell scripts run inside the OS image — must always be LF, even on Windows checkouts.
*.sh text eol=lf
*.conf text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.bat text eol=crlf
# Everything under os/ is read inside a Debian chroot or by the booted OS.
# A stray CR here is silent and expensive: a CRLF in the plymouth theme turns
# ModuleName into "script<CR>" and the splash simply never loads.
os/overlay/** text eol=lf
os/live/**    text eol=lf
os/overlay/seed/*.tar.gz    binary
os/overlay/branding/*.png   binary
